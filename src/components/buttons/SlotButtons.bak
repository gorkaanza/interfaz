        ...mapMutations(['cambiarMenu']),
		...mapState({
			nameCama: state => state.machine.model.sensors,
			nameTools: state => state.machine.model.tools,
			heaterTools: state => state.machine.model.heat.heaters,
			nameHeaters: state => state.machine.model.sensors,
		}),
		...mapState('machine/model', {
			boards: state => state.boards,
		}),
		T0Code: {
			get() {
				const valor_T0Code = this.$store.state.machine.model.global.T0;
				return (valor_T0Code);
			},
			
		},

	},
    methods: {
        change(){
			//router.push('Job/Status')
            this.cambiarMenu;
        },
		clickNums(num){
			if (this.cadenaNum == "0") {
				this.cadenaNum = "";
			}
			this.cadenaNum +=  "" + num;
		},
		deleteNums(){
			this.cadenaNum = this.cadenaNum.substring(0, this.cadenaNum.length - 1);
			if (this.cadenaNum.length <= 0) {
				this.cadenaNum = "0";
			}
		},
		okNums(){
			this.marcador = false;
			this.mixing = false;
			this.cadenaNum = "0";
		},
		keyboardScreen(toolTemperature){
			this.toolClickTemperature = toolTemperature;
			this.marcador = true;
		},
		keyboardScreenMix(toolTemperature){
			this.toolClickTemperature = toolTemperature;
			this.mixing = true;
		},

		cambiarRuta(ruta){
			this.$router.push(ruta)
		},
		
    }
    
}
</script>
