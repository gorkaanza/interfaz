<script>
'use strict'

//import store from '../../store'
import {  mapMutations, mapState } from 'vuex'
import CodeBtn from './CodeBtn.vue'
//import router from '../../routes';

export default {
  components: { CodeBtn },
	data() {
		return {
			cadenaNum: "0",
			numeros: null,
			marcador: false,
			toolClickTemperature: null, 
		}
	},
    computed: {
        ...mapMutations(['cambiarMenu']),
		...mapState({
			nameCama: state => state.machine.model.sensors,
			nameTools: state => state.machine.model.tools,
			heaterTools: state => state.machine.model.heat.heaters,
		}),
		...mapState('machine/model', {
			boards: state => state.boards,
		}),

	},
    methods: {
        change(){
			//router.push('Job/Status')
            this.cambiarMenu;
        },
		clickNums(num){
			if (this.cadenaNum == "0") {
				this.cadenaNum = "";
			}
			this.cadenaNum +=  "" + num;
		},
		deleteNums(){
			this.cadenaNum = this.cadenaNum.substring(0, this.cadenaNum.length - 1);
			if (this.cadenaNum.length <= 0) {
				this.cadenaNum = "0";
			}
		},
		okNums(){
			this.marcador = false;
			this.cadenaNum = "0";
		},
		keyboardScreen(toolTemperature){
			this.toolClickTemperature = toolTemperature;
			this.marcador = true;
		}
    }
    
}
</script>
