{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true
    },
    "vueCompilerOptions": {
        "target": 2
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}